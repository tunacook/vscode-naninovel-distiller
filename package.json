{
  "name": "vscode-naninovel-distiller",
  "displayName": "Naninovel Distiller",
  "description": "Naninovelシナリオの文字数統計を表示します",
  "version": "0.0.1",
  "publisher": "tunacook",
  "license": "MIT",
  "preview": true,
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "naninovel",
    "nani",
    "unity",
    "visual novel",
    "scenario",
    "word count"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/tunacook/vscode-naninovel-distiller.git"
  },
  "bugs": {
    "url": "https://github.com/tunacook/vscode-naninovel-distiller/issues"
  },
  "homepage": "https://github.com/tunacook/vscode-naninovel-distiller#readme",
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./dist/extension.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "naninovel-script-spec"
    ],
    "overrides": {
      "@azure/identity@<4.14.1": "^4.14.1",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@<6.14.0": "^6.14.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "shell-quote@<1.9.0": "^1.9.0"
    }
  },
  "contributes": {
    "configuration": {
      "title": "Naninovel Distiller",
      "properties": {
        "naninovelDistiller.excludeDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "docs",
            "staging-test"
          ],
          "description": "統計スキャンから除外するディレクトリ名のリスト（node_modules と . で始まるディレクトリは設定に関係なく常に除外される）"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nani-distiller-sidebar",
          "title": "Nani Distiller",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "nani-distiller-sidebar": [
        {
          "id": "naninovelStatsView",
          "name": "Scenario Statistics"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules pnpm-lock.yaml && pnpm install --ignore-workspace",
    "vscode:prepublish": "pnpm run package",
    "compile": "node esbuild.js",
    "compile-tests": "tsc -p .",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js",
    "test:all": "pnpm run test"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "glob": "^14.0.2",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "naninovel-script-spec": "github:tunacook/naninovel-script-spec#main"
  }
}